{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "checkJs": false,
    "baseUrl": "."
  },
  "include": [
    "frontend/src/**/*",
    "frontend/*.js",
    "frontend/*.jsx",
    "backend/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "frontend/node_modules",
    "frontend/node_modules/**",
    "backend/node_modules",
    "dist",
    "build"
  ]
}
